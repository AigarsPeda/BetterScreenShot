<Window x:Class="BetterScreenShot.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource ViewerPrimaryTextBrush}">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ViewerSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ViewerSurfaceBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#7AA2FF" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ViewerSurfacePressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C" />
                    <Setter Property="BorderBrush" Value="#B91C1C" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#991B1B" />
                    <Setter Property="BorderBrush" Value="#991B1B" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogSurface"
            Background="{DynamicResource ViewerPageBackgroundBrush}"
            BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Background="Transparent"
                      MouseLeftButtonDown="Title_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36"
                            Background="{DynamicResource DialogAccentBackgroundBrush}"
                            CornerRadius="10"
                            Margin="0,0,12,0">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="DialogIcon"
                                      Stroke="{DynamicResource DialogAccentBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="DialogTitle" Grid.Column="1"
                               TextWrapping="Wrap"
                               FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
                <Button Grid.Column="1"
                        Style="{StaticResource DialogButtonStyle}"
                        Width="32" MinWidth="32" Height="32" Padding="0"
                        Margin="8,0,0,0"
                        ToolTip="Close" AutomationProperties.Name="Close dialog"
                        Click="CancelButton_Click">
                    <Path Width="12" Height="12" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M1 1 11 11 M11 1 1 11" />
                </Button>
            </Grid>

            <TextBlock x:Name="MessageText" Grid.Row="1"
                       Margin="0,16,0,24"
                       FontSize="13" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{DynamicResource ViewerSecondaryTextBrush}" />

            <StackPanel x:Name="DetailsPanel" Grid.Row="2" Margin="0,0,0,24" Visibility="Collapsed">
                <TextBlock x:Name="DetailsCaption" Margin="0,0,0,8"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource ViewerSecondaryTextBrush}" />
                <Border Background="{DynamicResource ViewerSurfaceBrush}"
                        BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="12">
                    <TextBox x:Name="DetailsText"
                             IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             FontSize="12" TextWrapping="Wrap"
                             MaxHeight="160" VerticalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource ViewerSecondaryTextBrush}"
                             AutomationProperties.Name="Message details" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelActionButton"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="_Cancel" Margin="0,0,8,0"
                        IsCancel="True" IsDefault="True"
                        Click="CancelButton_Click" />
                <Button x:Name="PrimaryActionButton"
                        Style="{StaticResource DeleteButtonStyle}"
                        Content="_Delete"
                        Click="PrimaryButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
