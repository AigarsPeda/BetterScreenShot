<Window x:Class="BetterScreenShot.CaptureShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="620" Height="720" MinHeight="500" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource ViewerPageBackgroundBrush}" Foreground="{DynamicResource ViewerPrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="22" Height="22">
                                    <Border x:Name="FocusRing" BorderBrush="{DynamicResource ViewerAccentBrush}" BorderThickness="2" CornerRadius="6" Visibility="Collapsed" />
                                    <Border x:Name="CheckChrome" Width="18" Height="18" Background="{DynamicResource ViewerSurfaceBrush}"
                                            BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}" BorderThickness="1" CornerRadius="4" />
                                    <Path x:Name="CheckMark" Data="M3 8L6.5 11.5L13 4" Width="16" Height="16" Stretch="None"
                                          Stroke="{DynamicResource ViewerAccentTextBrush}" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource ViewerAccentBrush}" />
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource ViewerAccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="IsChecked" Value="False" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
                                <Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" />
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource ViewerAccentBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24" Margin="1,0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Name="ScrollThumb" Background="{DynamicResource ViewerSecondaryTextBrush}" Opacity="0.5" CornerRadius="3" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollThumb" Property="Opacity" Value="0.8" /></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="{DynamicResource ViewerAccentBrush}" /><Setter TargetName="ScrollThumb" Property="Opacity" Value="1" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemChrome" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4"><ContentPresenter /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource ViewerSelectedBrush}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource ViewerSelectedBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" /><Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="PickerChrome" Background="{DynamicResource ViewerSurfaceBrush}" BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PickerChrome" Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" /></Trigger>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="PickerChrome" Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Margin="10,0,23,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" />
                    <Path Data="M0 0L4 4 8 0" Width="8" Height="4" Stroke="{DynamicResource ViewerSecondaryTextBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                    <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="3" Background="{DynamicResource ViewerSurfaceBrush}" BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}" BorderThickness="1" CornerRadius="7">
                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" CanContentScroll="True" Background="Transparent">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShortcutButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{DynamicResource ViewerSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ViewerSurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ViewerAccentBrush}" /><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShortcutRecorderStyle" TargetType="Button" BasedOn="{StaticResource ShortcutButtonStyle}">
            <Setter Property="Width" Value="195" /><Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="Consolas" /><Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" />
        </Style>
        <Style x:Key="ShortcutPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ShortcutButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ViewerAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ViewerAccentTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ViewerAccentBrush}" BorderThickness="0" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.9" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
    <StackPanel Margin="22,22,22,10">
        <TextBlock Text="Capture from any app" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="Click a shortcut, then press the keys you want to use. While listening, the recorder keeps those keys from reaching other apps." Margin="0,7,0,18" TextWrapping="Wrap" Foreground="{DynamicResource ViewerSecondaryTextBrush}" />
        <Border Background="{DynamicResource ViewerSurfaceBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Capture Full Screen" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button x:Name="FullScreenShortcutButton" Grid.Column="1" Tag="FullScreen" Style="{StaticResource ShortcutRecorderStyle}" Content="Click to set"
                        Click="RecordShortcut_Click" PreviewKeyDown="Shortcut_PreviewKeyDown" LostKeyboardFocus="Shortcut_LostFocus" AutomationProperties.Name="Full screen shortcut" />
                <Button Grid.Column="2" Tag="FullScreen" Style="{StaticResource ShortcutButtonStyle}" Content="Clear" Margin="8,0,0,0" Padding="8,0" Click="ClearShortcut_Click" AutomationProperties.Name="Clear full screen shortcut" />
            </Grid>
        </Border>
        <Border Background="{DynamicResource ViewerSurfaceBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Select Area" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button x:Name="AreaShortcutButton" Grid.Column="1" Tag="Area" Style="{StaticResource ShortcutRecorderStyle}" Content="Click to set"
                        Click="RecordShortcut_Click" PreviewKeyDown="Shortcut_PreviewKeyDown" LostKeyboardFocus="Shortcut_LostFocus" AutomationProperties.Name="Area shortcut" />
                <Button Grid.Column="2" Tag="Area" Style="{StaticResource ShortcutButtonStyle}" Content="Clear" Margin="8,0,0,0" Padding="8,0" Click="ClearShortcut_Click" AutomationProperties.Name="Clear area shortcut" />
            </Grid>
        </Border>
        <CheckBox x:Name="WindowsSnipShortcutCheck" Content="Use Shift+Win+S for Select Area" Margin="2,0,0,6"
                  AutomationProperties.Name="Use Shift Win S for Select Area" />
        <TextBlock Text="Takes over the Windows Snipping Tool shortcut while BetterScreenShot is running. Turn this off to restore Windows behavior."
                   Margin="2,0,0,14" TextWrapping="Wrap" Foreground="{DynamicResource ViewerSecondaryTextBrush}" />
        <TextBlock Text="Use Ctrl, Alt, or Win with a key, or a function key. Clear disables a shortcut. Saving checks whether another app has reserved it." TextWrapping="Wrap" Foreground="{DynamicResource ViewerSecondaryTextBrush}" LineHeight="19" />
        <TextBlock Text="Editor shortcuts" FontSize="19" FontWeight="SemiBold" Margin="0,24,0,6" />
        <TextBlock Text="Choose one letter per tool. E stays assigned to Extract text." Foreground="{DynamicResource ViewerSecondaryTextBrush}" Margin="0,0,0,12" />
        <WrapPanel x:Name="EditorShortcutPanel" Margin="0,0,0,6" />
        <TextBlock Text="Editor defaults" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,12" />
        <Border Background="{DynamicResource ViewerSurfaceBrush}" CornerRadius="12" Padding="16">
            <StackPanel>
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Starting tool" VerticalAlignment="Center" />
                    <ComboBox x:Name="DefaultToolPicker" Grid.Column="1" AutomationProperties.Name="Starting tool" />
                </Grid>
                <CheckBox x:Name="RememberToolCheck" Content="Remember the last-used tool" Margin="0,0,0,16" Foreground="{DynamicResource ViewerPrimaryTextBrush}" />
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Annotation color" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox x:Name="DefaultColorPicker" Width="104" AutomationProperties.Name="Default annotation color" />
                        <Button Content="Custom…" Style="{StaticResource ShortcutButtonStyle}" Width="70" Padding="4,0" Margin="6,0,0,0" Click="CustomColor_Click" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Stroke width" VerticalAlignment="Center" />
                    <ComboBox x:Name="DefaultStrokePicker" Grid.Column="1" AutomationProperties.Name="Default stroke width">
                        <ComboBoxItem Content="Thin" Tag="2" /><ComboBoxItem Content="Medium" Tag="4" /><ComboBoxItem Content="Thick" Tag="7" />
                    </ComboBox>
                </Grid>
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Text size" VerticalAlignment="Center" />
                    <ComboBox x:Name="DefaultTextSizePicker" Grid.Column="1" AutomationProperties.Name="Default text size">
                        <ComboBoxItem Content="16" /><ComboBoxItem Content="24" /><ComboBoxItem Content="28" /><ComboBoxItem Content="40" /><ComboBoxItem Content="64" />
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="DefaultSketchCheck" Content="Use Sketch outlines by default" Foreground="{DynamicResource ViewerPrimaryTextBrush}" />
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="{DynamicResource ViewerPageBackgroundBrush}" Padding="22,10,22,16">
        <StackPanel>
        <TextBlock x:Name="ShortcutError" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource ShortcutErrorBrush}" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource ShortcutButtonStyle}" Content="Cancel" IsCancel="True" MinWidth="80" Margin="0,0,8,0" />
            <Button x:Name="SaveShortcutsButton" Style="{StaticResource ShortcutPrimaryButtonStyle}" Content="Save settings" IsDefault="True" Click="SaveShortcuts_Click" />
        </StackPanel>
        </StackPanel>
    </Border>
    </Grid>
</Window>
