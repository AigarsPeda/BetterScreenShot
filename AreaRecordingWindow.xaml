<Window x:Class="BetterScreenShot.AreaRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record area" Width="380" Height="112" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" WindowStartupLocation="Manual" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" FontFamily="Segoe UI" FontSize="12"
        Background="Transparent" Foreground="{DynamicResource ViewerPrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource ViewerSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ViewerSurfaceBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ViewerAccentBrush}" /><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Margin="3" CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}"
            Background="{DynamicResource ViewerPageBackgroundBrush}">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Opacity="0.28" /></Border.Effect>
        <Grid Margin="11,9">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⋮⋮  Record area" FontSize="11" FontWeight="SemiBold" Cursor="SizeAll"
                           MouseLeftButtonDown="ToolbarGrip_MouseLeftButtonDown" />
                <StackPanel x:Name="RecordingIndicator" Orientation="Horizontal" Margin="14,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed"
                            AutomationProperties.Name="Recording in progress">
                    <Ellipse Width="9" Height="9" Fill="#E5484D" />
                    <TextBlock Text="REC" Margin="5,0,0,0" FontSize="10" FontWeight="Bold"
                               Foreground="#E5484D" />
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="ActionsPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0">
                <Button x:Name="VideoButton" Content="Record video" Click="Video_Click" Margin="0,0,7,0" />
                <Button x:Name="GifButton" Content="Record GIF" Click="Gif_Click" Margin="0,0,7,0" />
                <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False"
                        Visibility="Collapsed" Margin="0,0,7,0" />
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" />
            </StackPanel>
            <TextBlock x:Name="CaptureStatus" Grid.Row="2" Text="Choose video or GIF to start recording."
                       TextTrimming="CharacterEllipsis" Margin="0,6,0,0" FontSize="11"
                       Foreground="{DynamicResource ViewerSecondaryTextBrush}" />
        </Grid>
    </Border>
</Window>
