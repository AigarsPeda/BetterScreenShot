<Window x:Class="BetterScreenShot.AreaRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record area" Width="384" Height="102" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" WindowStartupLocation="Manual" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" FontFamily="Segoe UI" FontSize="12"
        Background="Transparent" Foreground="{DynamicResource ViewerPrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{DynamicResource ViewerSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ViewerSurfaceBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.86" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ViewerAccentBrush}" /><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemChrome" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4">
                    <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource ViewerSelectedBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="PickerChrome" Background="{DynamicResource ViewerSurfaceBrush}"
                                    BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}"
                                    BorderThickness="1" CornerRadius="7" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PickerChrome" Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Margin="9,0,21,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}" />
                    <Path Data="M0 0L4 4 8 0" Width="8" Height="4"
                          Stroke="{DynamicResource ViewerSecondaryTextBrush}" StrokeThickness="1.3"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                          IsHitTestVisible="False" />
                    <Popup Name="PART_Popup" Placement="Top"
                           PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                Padding="3" Background="{DynamicResource ViewerSurfaceBrush}"
                                BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}"
                                BorderThickness="1" CornerRadius="7">
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Margin="3" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}"
            Background="{DynamicResource ViewerPageBackgroundBrush}">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="3" Opacity="0.28" /></Border.Effect>
        <Grid x:Name="ToolbarLayout" Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="112" /><ColumnDefinition Width="8" />
                <ColumnDefinition Width="112" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Text="⋮⋮  Record area" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center" Cursor="SizeAll"
                       MouseLeftButtonDown="ToolbarGrip_MouseLeftButtonDown" />
            <TextBlock x:Name="ModeLabel" Grid.Column="2" Text="Video quality" FontSize="11"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource ViewerSecondaryTextBrush}"
                       AutomationProperties.LiveSetting="Polite" />
            <ComboBox x:Name="VideoQualityPicker" Grid.Column="4" Width="112" Height="26" SelectedIndex="1"
                      FontSize="11" VerticalContentAlignment="Center"
                      Background="{DynamicResource ViewerSurfaceBrush}"
                      Foreground="{DynamicResource ViewerPrimaryTextBrush}"
                      BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}"
                      ToolTip="Standard: 15 fps and smaller files. High: 30 fps and clearer video. Maximum: 30 fps and highest detail with larger files."
                      AutomationProperties.Name="Video quality">
                <ComboBoxItem Content="Standard" />
                <ComboBoxItem Content="High" />
                <ComboBoxItem Content="Maximum" />
            </ComboBox>
            <StackPanel x:Name="RecordingIndicator" Grid.Column="4" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                        AutomationProperties.Name="Recording in progress">
                <Ellipse Width="9" Height="9" Fill="#E5484D" />
                <TextBlock Text="REC" Margin="5,0,0,0" FontSize="10" FontWeight="Bold"
                           Foreground="#E5484D" />
                <TextBlock x:Name="RecordingDuration" Text="0:00" Width="50" Margin="7,0,0,0"
                           FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource ViewerPrimaryTextBrush}"
                           AutomationProperties.Name="Recording duration" />
            </StackPanel>
            <Grid x:Name="ActionsPanel" Grid.Row="1" Grid.ColumnSpan="5" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="112" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <Button x:Name="VideoButton" Grid.Column="0" Content="Record video" Click="Video_Click"
                        Background="{DynamicResource ViewerAccentBrush}"
                        Foreground="{DynamicResource ViewerAccentTextBrush}" />
                <Button x:Name="GifButton" Grid.Column="2" Content="Record GIF" Click="Gif_Click" />
                <Button x:Name="StopButton" Grid.Column="0" Content="Stop" Click="Stop_Click"
                        IsEnabled="False" Visibility="Collapsed" Background="#D63D47" Foreground="White"
                        BorderBrush="#D63D47" />
                <Button x:Name="CancelButton" Grid.Column="4" Content="Cancel" Click="Cancel_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
