<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.2.15</Version>
    <Authors>A. Peda</Authors>
    <Company>A. Peda</Company>
    <Copyright>Copyright © 2026 A. Peda</Copyright>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\BetterScreenShot.ico</ApplicationIcon>
    <!-- WPF owns startup, so DPI awareness must be set in the manifest before HWND creation. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AutoInstallOnLaunch)' == 'false'">
    <DefineConstants>$(DefineConstants);PORTABLE_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.3" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="OcrAssets\**\*.cs" />
    <ProjectReference Include="OcrAssets\BetterScreenShot.OcrAssets.csproj" />
    <EmbeddedResource Include="scripts\Uninstall.ps1" LogicalName="BetterScreenShot.install.Uninstall.ps1" />
    <EmbeddedResource Include="assets\camera.svg" LogicalName="BetterScreenShot.assets.camera.svg" />
  </ItemGroup>

</Project>



