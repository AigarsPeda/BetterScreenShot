<Window x:Class="BetterScreenShot.ScreenshotToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot Saved"
        Width="310"
        Height="215"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Opacity="0"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="ToastSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToastImageBrush" Color="#E3E3EA" />
        <SolidColorBrush x:Key="ToastPrimaryTextBrush" Color="#252735" />
        <SolidColorBrush x:Key="ToastSecondarySurfaceBrush" Color="#F0F0F8" />
        <SolidColorBrush x:Key="ToastAccentBrush" Color="#625FC6" />
        <SolidColorBrush x:Key="ToastAccentTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToastFocusBrush" Color="#625FC6" />

        <Style x:Key="ToastActionStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionSurface" Property="BorderBrush" Value="{DynamicResource ToastFocusBrush}" />
                                <Setter TargetName="ActionSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToastCornerStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource ToastSurfaceBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CornerSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CornerSurface" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CornerSurface" Property="BorderBrush" Value="{DynamicResource ToastFocusBrush}" />
                                <Setter TargetName="CornerSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LucideStrokeStyle" TargetType="Shape">
            <Setter Property="Stroke" Value="{DynamicResource ToastPrimaryTextBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </Window.Resources>

    <Border x:Name="PreviewBorder"
            Background="{DynamicResource ToastSurfaceBrush}"
            CornerRadius="16"
            Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="7" Color="#1B1D2A" Opacity="0.25" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ToastImageBrush}"
                    CornerRadius="10"
                    ClipToBounds="True">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="UniformToFill" SizeChanged="PreviewImage_SizeChanged" />
                    <Button Style="{StaticResource ToastCornerStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,7,7,0"
                            ToolTip="Discard screenshot"
                            AutomationProperties.Name="Discard screenshot"
                            Click="CloseButton_Click">
                        <Viewbox Width="15" Height="15">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource LucideStrokeStyle}" Data="M18 6 6 18" />
                                <Path Style="{StaticResource LucideStrokeStyle}" Data="M6 6 18 18" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ToastCornerStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,7,7"
                            ToolTip="Open editor"
                            AutomationProperties.Name="Open editor"
                            Click="PreviewButton_Click">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource LucideStrokeStyle}"
                                      Data="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
                                <Path Style="{StaticResource LucideStrokeStyle}" Data="M15 5 19 9" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Style="{StaticResource ToastActionStyle}"
                        Background="{DynamicResource ToastAccentBrush}"
                        Foreground="{DynamicResource ToastAccentTextBrush}"
                        AutomationProperties.Name="Copy screenshot"
                        Click="CopyButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,7,0">
                            <Canvas Width="24" Height="24">
                                <Rectangle Style="{StaticResource LucideStrokeStyle}"
                                           Stroke="{DynamicResource ToastAccentTextBrush}"
                                           Width="14" Height="14" RadiusX="2" RadiusY="2"
                                           Canvas.Left="8" Canvas.Top="8" />
                                <Path Style="{StaticResource LucideStrokeStyle}"
                                      Stroke="{DynamicResource ToastAccentTextBrush}"
                                      Data="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Copy" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        Style="{StaticResource ToastActionStyle}"
                        Background="{DynamicResource ToastSecondarySurfaceBrush}"
                        Foreground="{DynamicResource ToastPrimaryTextBrush}"
                        AutomationProperties.Name="Save screenshot"
                        Click="SaveButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,7,0">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource LucideStrokeStyle}"
                                      Data="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" />
                                <Path Style="{StaticResource LucideStrokeStyle}"
                                      Data="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7" />
                                <Path Style="{StaticResource LucideStrokeStyle}" Data="M7 3v4a1 1 0 0 0 1 1h7" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Save" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
