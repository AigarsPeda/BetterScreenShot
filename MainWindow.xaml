<Window x:Class="BetterScreenShot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Height="320"
        Width="520"
        MinHeight="290"
        MinWidth="380"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="{DynamicResource PageBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F7F7F3" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DividerBrush" Color="#E3E3EA" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0F0F8" />
        <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E8E7F5" />
        <SolidColorBrush x:Key="FocusBrush" Color="#625FC6" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#252735" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#636978" />
        <SolidColorBrush x:Key="AccentBrush" Color="#625FC6" />
        <SolidColorBrush x:Key="StatusNeutralBrush" Color="Transparent" />
        <SolidColorBrush x:Key="StatusNeutralTextBrush" Color="#636978" />
        <SolidColorBrush x:Key="StatusSuccessBrush" Color="Transparent" />
        <SolidColorBrush x:Key="StatusSuccessTextBrush" Color="#2F7D5A" />
        <SolidColorBrush x:Key="StatusInfoBrush" Color="Transparent" />
        <SolidColorBrush x:Key="StatusInfoTextBrush" Color="#514CB6" />
        <SolidColorBrush x:Key="StatusErrorBrush" Color="Transparent" />
        <SolidColorBrush x:Key="StatusErrorTextBrush" Color="#B43E45" />

        <Style x:Key="CaptureIconStyle" TargetType="Shape">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
            <Setter Property="StrokeThickness" Value="3.2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>

        <Style x:Key="CaptureActionStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Height" Value="77" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionSurface" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="ActionSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="16"
                Padding="5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="6" Color="#252735" Opacity="0.12" />
            </Border.Effect>
            <StackPanel>
                <Button x:Name="CaptureButton"
                        Style="{StaticResource CaptureActionStyle}"
                        Click="CaptureButton_Click"
                        AutomationProperties.Name="Capture full screen">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="21" Height="21" Stretch="Uniform" VerticalAlignment="Center">
                            <Canvas Width="40" Height="40">
                                <Path Style="{StaticResource CaptureIconStyle}"
                                      Data="M7 9 H33 A3 3 0 0 1 36 12 V26 A3 3 0 0 1 33 29 H7 A3 3 0 0 1 4 26 V12 A3 3 0 0 1 7 9 Z" />
                                <Path Style="{StaticResource CaptureIconStyle}" Data="M14 34 H26" />
                                <Path Style="{StaticResource CaptureIconStyle}" Data="M20 29 V34" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Capture Full Screen"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock x:Name="FullScreenShortcutLabel"
                                       Text="Shortcut not set"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Border Height="1" Margin="10,0" Background="{DynamicResource DividerBrush}" />
                <Button x:Name="SelectAreaButton"
                        Style="{StaticResource CaptureActionStyle}"
                        Click="SelectAreaButton_Click"
                        AutomationProperties.Name="Select area">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="21" Height="21" Stretch="Uniform" VerticalAlignment="Center">
                            <Canvas Width="40" Height="40">
                                <Path Style="{StaticResource CaptureIconStyle}" Data="M12 9 H8 A3 3 0 0 0 5 12 V16" />
                                <Path Style="{StaticResource CaptureIconStyle}" Data="M28 9 H32 A3 3 0 0 1 35 12 V16" />
                                <Path Style="{StaticResource CaptureIconStyle}" Data="M35 24 V28 A3 3 0 0 1 32 31 H28" />
                                <Path Style="{StaticResource CaptureIconStyle}" Data="M12 31 H8 A3 3 0 0 1 5 28 V24" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Select Area"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock x:Name="AreaShortcutLabel"
                                       Text="Shortcut not set"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusBadge"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="{DynamicResource StatusNeutralBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot"
                             Width="7"
                             Height="7"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource StatusNeutralTextBrush}" />
                    <TextBlock x:Name="StatusTextBlock"
                               Grid.Column="1"
                               Margin="9,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource StatusNeutralTextBrush}"
                               Text="Ready to capture." />
                </Grid>
            </Border>
            <Button x:Name="ShortcutsButton"
                    Grid.Column="1"
                    Content="Shortcuts…"
                    Margin="8,0,0,0"
                    Style="{StaticResource FooterButtonStyle}"
                    FontSize="12"
                    Click="ShortcutsButton_Click"
                    ToolTip="Configure capture keyboard shortcuts" />
        </Grid>
    </Grid>
</Window>
