<Window x:Class="BetterScreenShot.ScreenshotViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BetterScreenShot"
        Title="Screenshot Editor" Width="1100" Height="780" MinWidth="620" MinHeight="450"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource ViewerPageBackgroundBrush}" Foreground="{DynamicResource ViewerPrimaryTextBrush}"
        PreviewKeyDown="Editor_KeyDown" PreviewKeyUp="Editor_KeyUp">
    <Window.Resources>
        <SolidColorBrush x:Key="ViewerPageBackgroundBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="ViewerSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ViewerSurfaceBorderBrush" Color="#D8E1EC" />
        <SolidColorBrush x:Key="ViewerSurfaceHoverBrush" Color="#F5F9FD" />
        <SolidColorBrush x:Key="ViewerSurfacePressedBrush" Color="#EEF4FB" />
        <SolidColorBrush x:Key="ViewerPrimaryTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="ViewerSecondaryTextBrush" Color="#415063" />
        <SolidColorBrush x:Key="ViewerCanvasBrush" Color="#EDEFF4" />
        <Style x:Key="AnnotationContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="MinWidth" Value="195" /><Setter Property="FontSize" Value="13" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AnnotationMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="MenuRow" Background="Transparent" CornerRadius="6" Padding="10,7">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="26,0,0,0" Opacity="0.55" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemChrome" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4"><ContentPresenter /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#34409CFF" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource ViewerSurfaceBrush}" BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}" BorderThickness="1" CornerRadius="6" /></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Margin="8,0,16,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" />
                    <TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,3" IsHitTestVisible="False" />
                    <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="3" Background="{DynamicResource ViewerSurfaceBrush}" BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}" BorderThickness="1" CornerRadius="7"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></Border>
                    </Popup>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ActionStyle" TargetType="Button">
            <Setter Property="Height" Value="34" /><Setter Property="Padding" Value="12,0" /><Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ViewerSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ViewerSurfaceBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ViewerSurfacePressedBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#409CFF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="Margin" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" CornerRadius="7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#24409CFF" /><Setter TargetName="Chrome" Property="BorderBrush" Value="#409CFF" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#409CFF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16,12,16,10">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="2,0,12,0">
                <TextBlock Text="Markup" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Name="ImageDetails" FontSize="11" Foreground="{DynamicResource ViewerSecondaryTextBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource ActionStyle}" Content="−" FontSize="20" Width="34" Padding="0" Click="ZoomOutButton_Click" ToolTip="Zoom out (Ctrl+−)" AutomationProperties.Name="Zoom out" />
                <Button Name="FitButton" Style="{StaticResource ActionStyle}" Content="Fit" MinWidth="54" Click="FitButton_Click" ToolTip="Fit image (Ctrl+0)" />
                <Button Style="{StaticResource ActionStyle}" Content="+" FontSize="20" Width="34" Padding="0" Click="ZoomInButton_Click" ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in" />
                <Button Name="CopyButton" Style="{StaticResource ActionStyle}" Content="Copy" FontWeight="SemiBold" MinWidth="78" Margin="12,2,2,2" Click="CopyButton_Click" ToolTip="Copy image with annotations (Ctrl+C)" AutomationProperties.Name="Copy image" />
                <Button Name="SaveButton" Style="{StaticResource ActionStyle}" Content="Save As…" FontWeight="SemiBold" Click="SaveAsButton_Click" ToolTip="Save a copy with annotations (Ctrl+Shift+S)" />
                <Button Style="{StaticResource ActionStyle}" Content="⋯" FontSize="20" Width="34" Padding="0" Click="MoreButton_Click" AutomationProperties.Name="More actions" ToolTip="More actions">
                    <Button.ContextMenu><ContextMenu><MenuItem Header="Discard screenshot…" Click="DeleteButton_Click" /></ContextMenu></Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource ViewerSurfaceBrush}" BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="7" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Name="ToolsPanel" Orientation="Horizontal" Margin="0,0,8,0" />
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <Button Name="UndoButton" Style="{StaticResource ActionStyle}" Padding="0" Width="32" Content="↶" FontSize="22" Click="UndoButton_Click" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo" />
                    <Button Name="RedoButton" Style="{StaticResource ActionStyle}" Padding="0" Width="32" Content="↷" FontSize="22" Click="RedoButton_Click" ToolTip="Redo (Ctrl+Shift+Z)" AutomationProperties.Name="Redo" />
                </StackPanel>
                <StackPanel Name="ColorsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                    <TextBlock Text="Stroke" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource ViewerSecondaryTextBrush}" />
                    <ComboBox Name="StrokeWidthPicker" Width="68" Height="28" SelectedIndex="1" SelectionChanged="StrokeWidth_Changed" ToolTip="Stroke width" AutomationProperties.Name="Stroke width">
                        <ComboBoxItem Content="Thin" Tag="2" /><ComboBoxItem Content="Medium" Tag="4" /><ComboBoxItem Content="Thick" Tag="7" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                    <TextBlock Text="Text" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource ViewerSecondaryTextBrush}" />
                    <ComboBox Name="FontSizePicker" Width="54" Height="28" SelectedIndex="2" SelectionChanged="FontSize_Changed" ToolTip="Text size in image pixels" AutomationProperties.Name="Text size">
                        <ComboBoxItem Content="16" /><ComboBoxItem Content="24" /><ComboBoxItem Content="28" /><ComboBoxItem Content="40" /><ComboBoxItem Content="64" />
                    </ComboBox>
                </StackPanel>
                <Button Name="RemoveButton" Style="{StaticResource ActionStyle}" Content="Delete" Click="RemoveButton_Click" ToolTip="Delete selected annotation (Delete)" />
                <ToggleButton x:Name="SketchToggle" IsChecked="True" Click="SketchToggle_Click" Width="72" Margin="5,1,1,1"
                              Style="{StaticResource ToolStyle}" Content="Sketch" ToolTip="Hand-drawn outlines for all shapes. Turn off for precise lines." AutomationProperties.Name="Sketch style" />
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource ViewerCanvasBrush}" BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <Grid Name="ImageViewport" ClipToBounds="True" Background="Transparent" SizeChanged="Viewport_SizeChanged"
                  MouseWheel="ImageViewport_MouseWheel" MouseLeftButtonDown="ImageViewport_MouseLeftButtonDown"
                  MouseMove="ImageViewport_MouseMove" MouseLeftButtonUp="ImageViewport_MouseLeftButtonUp" LostMouseCapture="Viewport_LostMouseCapture">
                <Viewbox Name="ImageFit" Margin="20" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform><TransformGroup><ScaleTransform x:Name="ImageScaleTransform" /><TranslateTransform x:Name="ImageTranslateTransform" /></TransformGroup></Viewbox.RenderTransform>
                    <Grid Name="ImageStage" ClipToBounds="True">
                        <Image Name="ViewerImage" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
                        <local:AnnotationSurface x:Name="Annotations" />
                        <Canvas Name="TextLayer">
                            <TextBox Name="InlineText" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="NoWrap" MinWidth="80" Padding="3" BorderBrush="#409CFF" BorderThickness="1"
                                     Foreground="Black" Background="#F2FFFFFF" LostKeyboardFocus="InlineText_LostFocus" PreviewKeyDown="InlineText_KeyDown" AutomationProperties.Name="Annotation text" />
                        </Canvas>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="3,9,3,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Name="ToolHint" Text="Choose a tool to mark up your screenshot. Space to pan." FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ViewerSecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Name="AnnotationCount" Grid.Column="1" FontSize="11" Margin="12,0,0,0" Foreground="{DynamicResource ViewerSecondaryTextBrush}" />
        </Grid>
    </Grid>
</Window>
