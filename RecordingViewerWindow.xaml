<Window x:Class="BetterScreenShot.RecordingViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View recording" Width="1100" Height="780" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource ViewerPageBackgroundBrush}"
        Foreground="{DynamicResource ViewerPrimaryTextBrush}">
    <Window.Resources>
        <Style x:Key="ActionStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ViewerSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ViewerAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ViewerSurfacePressedBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryActionStyle" TargetType="Button" BasedOn="{StaticResource ActionStyle}">
            <Setter Property="Background" Value="{DynamicResource ViewerAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ViewerAccentTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ViewerPrimaryTextBrush}"
                                BorderThickness="0" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.9" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16,12,16,10">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource ViewerCanvasBrush}" CornerRadius="12" ClipToBounds="True">
            <Grid x:Name="RecordingViewport" ClipToBounds="True">
                <Grid x:Name="RecordingStage" Margin="0,58,0,0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="RecordingScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                    <Image x:Name="PosterImage" Stretch="Uniform" />
                    <Image x:Name="GifImage" Stretch="Uniform" Visibility="Collapsed" />
                    <MediaElement x:Name="VideoPlayer" Stretch="Uniform" Visibility="Collapsed"
                                  LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                  MediaOpened="Video_MediaOpened" MediaEnded="Video_MediaEnded"
                                  MediaFailed="Video_MediaFailed" />
                </Grid>
                <TextBlock x:Name="PlaybackStatus" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Padding="10,6" FontSize="12" Text="Loading recording…"
                           Background="{DynamicResource ViewerSurfaceBrush}"
                           Foreground="{DynamicResource ViewerSecondaryTextBrush}" />
            </Grid>
        </Border>
        <Grid x:Name="ViewerToolbar" Grid.Row="0" Panel.ZIndex="3" VerticalAlignment="Top" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ZoomOutButton" Style="{StaticResource ActionStyle}" Width="34" Padding="0" Click="ZoomOut_Click"
                        ToolTip="Zoom out" AutomationProperties.Name="Zoom out">
                    <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M5 12h14" Stroke="{DynamicResource ViewerPrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                </Button>
                <Button x:Name="FitButton" Style="{StaticResource ActionStyle}" Content="Fit" MinWidth="54" Click="Fit_Click"
                        ToolTip="Fit recording" AutomationProperties.Name="Fit recording" />
                <Button x:Name="ZoomInButton" Style="{StaticResource ActionStyle}" Width="34" Padding="0" Click="ZoomIn_Click"
                        ToolTip="Zoom in" AutomationProperties.Name="Zoom in">
                    <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M5 12h14 M12 5v14" Stroke="{DynamicResource ViewerPrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CopyButton" Style="{StaticResource ActionStyle}"
                        FontWeight="SemiBold" MinWidth="78" Click="Copy_Click"
                        ToolTip="Copy recording file" AutomationProperties.Name="Copy recording">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M8 8h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2z M4 16a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2"
                              Width="18" Height="18" Stretch="Uniform" Margin="0,0,7,0"
                              Stroke="{DynamicResource ViewerPrimaryTextBrush}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock Text="Copy" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource PrimaryActionStyle}"
                        FontWeight="SemiBold" Click="Save_Click"
                        ToolTip="Save recording file" AutomationProperties.Name="Save recording">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7 M7 3v4a1 1 0 0 0 1 1h7"
                              Width="18" Height="18" Stretch="Uniform" Margin="0,0,7,0"
                              Stroke="{DynamicResource ViewerAccentTextBrush}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Border x:Name="PlaybackBar" Grid.Row="1" Margin="0,10,0,0" Padding="10,7"
                Background="{DynamicResource ViewerSurfaceBrush}"
                BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}"
                BorderThickness="1" CornerRadius="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayPauseButton" Grid.Column="0" Style="{StaticResource ActionStyle}"
                        Content="Play" Width="78" IsEnabled="False" Click="PlayPause_Click"
                        AutomationProperties.Name="Play recording" />
                <Button x:Name="StopButton" Grid.Column="1" Style="{StaticResource ActionStyle}"
                        Content="Stop" Width="64" IsEnabled="False" Click="Stop_Click"
                        AutomationProperties.Name="Stop recording playback" />
                <Slider x:Name="PositionSlider" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"
                        Minimum="0" Maximum="1" IsEnabled="False" ValueChanged="PositionSlider_ValueChanged"
                        AutomationProperties.Name="Recording position" />
                <TextBlock x:Name="TimeText" Grid.Column="3" Text="0:00 / 0:00" MinWidth="86"
                           TextAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource ViewerSecondaryTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
