<Window x:Class="BetterScreenShot.ScreenshotViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BetterScreenShot"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Screenshot Editor" Width="1100" Height="780" MinWidth="620" MinHeight="450"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" PreviewDragOver="Editor_PreviewDragOver" PreviewDrop="Editor_PreviewDrop"
        Background="{DynamicResource ViewerPageBackgroundBrush}" Foreground="{DynamicResource ViewerPrimaryTextBrush}"
        PreviewKeyDown="Editor_KeyDown" PreviewKeyUp="Editor_KeyUp">
    <Window.Resources>
        <sys:Double x:Key="ToolbarButtonSize">40</sys:Double>
        <Style x:Key="KeyboardFocusStyle" TargetType="Control">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
                <Border BorderBrush="{DynamicResource ViewerPrimaryTextBrush}" BorderThickness="2" CornerRadius="8" Margin="-2" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ColorSwatchStyle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <SolidColorBrush x:Key="ViewerPageBackgroundBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="ViewerSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ViewerSurfaceBorderBrush" Color="#D8E1EC" />
        <SolidColorBrush x:Key="ViewerSurfaceHoverBrush" Color="#F5F9FD" />
        <SolidColorBrush x:Key="ViewerSurfacePressedBrush" Color="#EEF4FB" />
        <SolidColorBrush x:Key="ViewerPrimaryTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="ViewerSecondaryTextBrush" Color="#415063" />
        <SolidColorBrush x:Key="ViewerCanvasBrush" Color="#EDEFF4" />
        <SolidColorBrush x:Key="ViewerAccentBrush" Color="#625FC6" />
        <SolidColorBrush x:Key="ViewerAccentTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ViewerSelectedBrush" Color="#ECEBFF" />
        <SolidColorBrush x:Key="ViewerSelectionFillBrush" Color="#44625FC6" />
        <Style x:Key="OcrSelectionHandleStyle" TargetType="Thumb">
            <Setter Property="Width" Value="20" /><Setter Property="Focusable" Value="False" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Grid>
                                <Rectangle Name="Caret" Width="2" Fill="{DynamicResource ViewerAccentBrush}" HorizontalAlignment="Center" Margin="0,6,0,2" />
                                <Ellipse Name="Grip" Width="8" Height="8" Fill="{DynamicResource ViewerAccentBrush}" Stroke="White" StrokeThickness="1"
                                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="End">
                                <Setter TargetName="Caret" Property="Margin" Value="0,2,0,6" />
                                <Setter TargetName="Grip" Property="VerticalAlignment" Value="Bottom" />
                                <Setter TargetName="Grip" Property="Margin" Value="0,0,0,2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Fill" Value="{DynamicResource ViewerAccentBrush}" /></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Fill" Value="{DynamicResource ViewerAccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OcrScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24" Margin="1,0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Name="ScrollThumb" Background="{DynamicResource ViewerSecondaryTextBrush}" Opacity="0.5" CornerRadius="3" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollThumb" Property="Opacity" Value="0.8" /></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="{DynamicResource ViewerAccentBrush}" /><Setter TargetName="ScrollThumb" Property="Opacity" Value="1" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExtractedTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AnnotationContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="MinWidth" Value="195" /><Setter Property="FontSize" Value="13" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AnnotationMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="MenuRow" Background="Transparent" CornerRadius="6" Padding="10,7">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="26,0,0,0" Opacity="0.55" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemChrome" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4"><ContentPresenter /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource ViewerSelectedBrush}" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" /><Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="12" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="PickerChrome" Background="{DynamicResource ViewerSurfaceBrush}" BorderBrush="{DynamicResource ViewerControlBorderBrush}" BorderThickness="1" CornerRadius="8" />
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PickerChrome" Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" /></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Margin="10,0,23,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" />
                    <Path Data="M0 0L4 4 8 0" Width="8" Height="4" Stroke="{DynamicResource ViewerSecondaryTextBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                    <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="3" Background="{DynamicResource ViewerSurfaceBrush}" BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}" BorderThickness="1" CornerRadius="7"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></Border>
                    </Popup>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ActionStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Height" Value="34" /><Setter Property="Padding" Value="12,0" /><Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ViewerSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ViewerAccentBrush}" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ActionContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ViewerSurfacePressedBrush}" /></Trigger>

                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                        <Trigger Property="local:ActionButtonFeedback.IsActive" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#187846" />
                                <Setter TargetName="ActionContent" Property="Content" Value="{Binding Path=(local:ActionButtonFeedback.Message), RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="ActionContent" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryActionStyle" TargetType="Button" BasedOn="{StaticResource ActionStyle}">
            <Setter Property="Background" Value="{DynamicResource ViewerAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ViewerAccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ViewerPrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ActionContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.9" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8" /></Trigger>

                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                        <Trigger Property="local:ActionButtonFeedback.IsActive" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#187846" />
                                <Setter TargetName="ActionContent" Property="Content" Value="{Binding Path=(local:ActionButtonFeedback.Message), RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="ActionContent" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Width" Value="28" /><Setter Property="Height" Value="34" /><Setter Property="Margin" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ViewerPrimaryTextBrush}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}" BorderThickness="0" BorderBrush="{DynamicResource ViewerAccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ViewerSurfaceHoverBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ViewerSelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource ViewerAccentBrush}" /></Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopRowToolStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToolStyle}">
            <Setter Property="Width" Value="{StaticResource ToolbarButtonSize}" /><Setter Property="Height" Value="{StaticResource ToolbarButtonSize}" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
        <Style x:Key="ToolbarActionStyle" TargetType="Button" BasedOn="{StaticResource ActionStyle}">
            <Setter Property="Height" Value="32" /><Setter Property="Margin" Value="2" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="ToolbarGroupStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="VerticalAlignment" Value="Top" /><Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </Window.Resources>
    <Grid>
    <Grid x:Name="EditorContent" SizeChanged="EditorContent_SizeChanged" Background="{DynamicResource ViewerCanvasBrush}">
        <Grid Name="Workspace">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Name="CanvasHost" Background="{DynamicResource ViewerCanvasBrush}" ClipToBounds="True">
            <Grid Name="ImageViewport" ClipToBounds="True" Background="Transparent" SizeChanged="Viewport_SizeChanged"
                  MouseWheel="ImageViewport_MouseWheel" MouseLeftButtonDown="ImageViewport_MouseLeftButtonDown"
                  MouseMove="ImageViewport_MouseMove" MouseLeftButtonUp="ImageViewport_MouseLeftButtonUp" LostMouseCapture="Viewport_LostMouseCapture">
                <Viewbox Name="ImageFit" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" SizeChanged="ImageFit_SizeChanged">
                    <Viewbox.RenderTransform><TransformGroup><ScaleTransform x:Name="ImageScaleTransform" /><TranslateTransform x:Name="ImageTranslateTransform" /></TransformGroup></Viewbox.RenderTransform>
                    <Grid Name="ImageStage" PreviewMouseLeftButtonDown="ImageStage_PreviewMouseLeftButtonDown">
                        <Grid ClipToBounds="True">
                        <Image Name="ViewerImage" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
                        <local:AnnotationSurface x:Name="Annotations" />
                        <Canvas IsHitTestVisible="False">
                            <Path Name="OcrSelectionHighlight" Visibility="Collapsed" Fill="{DynamicResource ViewerSelectionFillBrush}" Stroke="{DynamicResource ViewerAccentBrush}" StrokeThickness="1.5" />
                        </Canvas>
                        <Canvas Name="TextLayer">
                            <TextBox Name="InlineText" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="NoWrap" MinWidth="80" Padding="3" BorderBrush="{DynamicResource ViewerAccentBrush}" BorderThickness="1"
                                     Foreground="Black" Background="#F2FFFFFF" LostKeyboardFocus="InlineText_LostFocus" PreviewKeyDown="InlineText_KeyDown" AutomationProperties.Name="Annotation text" />
                        </Canvas>
                        </Grid>
                        <Canvas>
                            <Thumb Name="OcrSelectionStartHandle" Style="{StaticResource OcrSelectionHandleStyle}" Visibility="Collapsed" Tag="Start"
                                   AutomationProperties.Name="Start of text selection" DragStarted="OcrSelectionHandle_DragStarted" DragDelta="OcrSelectionHandle_DragDelta" DragCompleted="OcrSelectionHandle_DragCompleted" />
                            <Thumb Name="OcrSelectionEndHandle" Style="{StaticResource OcrSelectionHandleStyle}" Visibility="Collapsed" Tag="End"
                                   AutomationProperties.Name="End of text selection" DragStarted="OcrSelectionHandle_DragStarted" DragDelta="OcrSelectionHandle_DragDelta" DragCompleted="OcrSelectionHandle_DragCompleted" />
                        </Canvas>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>
        <Grid Name="ExtractedTextHost" Grid.Column="1" Width="0" Visibility="Collapsed" ClipToBounds="True">
        <Border Name="ExtractedTextPanel" Width="300" Margin="12,0,0,0" Padding="2,0,2,0" HorizontalAlignment="Left"
                Background="{DynamicResource ViewerSurfaceBrush}" CornerRadius="10">
            <Border.RenderTransform><TranslateTransform x:Name="ExtractedTextSlide" X="312" /></Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button Name="CloseExtractedTextButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarActionStyle}" Width="30" Padding="0" Click="CloseExtractedText_Click" ToolTip="Close text panel" AutomationProperties.Name="Close text panel">
                        <Path Data="M1 1L11 11 M11 1L1 11" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource ViewerPrimaryTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <TextBlock Name="ExtractedTextHeading" Text="Extracted text" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Name="OcrStatus" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource ViewerSecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
                <TextBox Name="ExtractedTextBox" Grid.Row="2" Style="{StaticResource ExtractedTextBoxStyle}" IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Padding="12" Background="{DynamicResource ViewerSurfaceBrush}" Foreground="{DynamicResource ViewerPrimaryTextBrush}"
                         SelectionChanged="ExtractedText_SelectionChanged" AutomationProperties.Name="Extracted text">
                    <TextBox.Resources>
                        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">8</sys:Double>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource OcrScrollBarStyle}" />
                    </TextBox.Resources>
                </TextBox>
                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <Expander Name="OcrAdvancedOptions" Header="Advanced options" IsExpanded="False" Margin="0,0,0,8" AutomationProperties.Name="Advanced text recognition options">
                        <Expander.Template>
                            <ControlTemplate TargetType="Expander">
                                <StackPanel>
                                    <ToggleButton Style="{StaticResource ToolStyle}" Width="Auto" Height="28" Padding="6,0" HorizontalAlignment="Left"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AutomationProperties.Name="Advanced text recognition options">
                                        <StackPanel Orientation="Horizontal" Margin="6,0">
                                            <Path Name="AdvancedArrow" Data="M1 1L5 5 1 9" Width="7" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  Stroke="{DynamicResource ViewerSecondaryTextBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ContentPresenter Name="AdvancedContent" ContentSource="Content" Visibility="Collapsed" Margin="2,8,2,4" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="True">
                                        <Setter TargetName="AdvancedContent" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="AdvancedArrow" Property="Data" Value="M1 3L5 7 9 3" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Expander.Template>
                        <StackPanel>
                            <TextBlock Text="Recognition language" FontSize="12" Foreground="{DynamicResource ViewerSecondaryTextBrush}" Margin="2,0,0,6" />
                            <ComboBox Name="OcrLanguagePicker" AutomationProperties.Name="Recognition language" SelectionChanged="OcrLanguage_Changed" />
                        </StackPanel>
                    </Expander>
                    <Button Name="RetryTextButton" Style="{StaticResource ActionStyle}" Content="Retry recognition" Visibility="Collapsed" Click="RetryText_Click" />
                    <Button Name="CopyExtractedTextButton" AutomationProperties.LiveSetting="Polite" Style="{StaticResource ActionStyle}" Content="Copy all text" IsEnabled="False" Click="CopyExtractedText_Click" />
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
        </Grid>
        <Grid Name="MarkupToolbar" Panel.ZIndex="3" VerticalAlignment="Top" Margin="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Name="MenuActions" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Name="MoreActionsButton" Style="{StaticResource ActionStyle}" Width="{StaticResource ToolbarButtonSize}" Height="{StaticResource ToolbarButtonSize}" Margin="2,0" Padding="0" Click="MoreButton_Click" AutomationProperties.Name="More actions" ToolTip="More actions">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="3" Height="3" Fill="{DynamicResource ViewerPrimaryTextBrush}" Margin="2,0" /><Ellipse Width="3" Height="3" Fill="{DynamicResource ViewerPrimaryTextBrush}" Margin="2,0" /><Ellipse Width="3" Height="3" Fill="{DynamicResource ViewerPrimaryTextBrush}" Margin="2,0" /></StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource AnnotationContextMenuStyle}" Background="{DynamicResource ViewerSurfaceBrush}"
                                     Foreground="{DynamicResource ViewerPrimaryTextBrush}" BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}">
                            <MenuItem x:Name="ThemeMenuItem" Header="Switch theme" Style="{StaticResource AnnotationMenuItemStyle}"
                                      Foreground="{DynamicResource ViewerPrimaryTextBrush}" Click="ThemeMenuItem_Click">
                                <MenuItem.Icon>
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="ThemeMenuIcon" Stroke="{DynamicResource ViewerPrimaryTextBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="FollowSystemThemeMenuItem" Header="Follow system theme" Style="{StaticResource AnnotationMenuItemStyle}"
                                      Foreground="{DynamicResource ViewerPrimaryTextBrush}" Click="FollowSystemThemeMenuItem_Click" Visibility="Collapsed" />
                            <MenuItem Header="Settings…" Style="{StaticResource AnnotationMenuItemStyle}"
                                      Foreground="{DynamicResource ViewerPrimaryTextBrush}" Click="SettingsMenuItem_Click" />
                            <MenuItem x:Name="DiscardMenuItem" Header="Discard screenshot…" Style="{StaticResource AnnotationMenuItemStyle}"
                                      Foreground="{DynamicResource ViewerPrimaryTextBrush}" Click="DeleteButton_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <ToggleButton Name="PropertiesButton" Style="{StaticResource TopRowToolStyle}" Background="{DynamicResource ViewerSurfaceBrush}" Margin="6,0,1,0" Click="PropertiesButton_Click" ToolTip="Tool properties" AutomationProperties.Name="Tool properties">
                    <Path Data="M3 6h18 M3 12h18 M3 18h18 M8 3v6 M16 9v6 M10 15v6" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ViewerPrimaryTextBrush}" StrokeThickness="1.5" />
                </ToggleButton>
            </StackPanel>
            <Grid Name="ToolDock" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0">
                <Border Background="{DynamicResource ViewerSurfaceBrush}" CornerRadius="10" IsHitTestVisible="False" />
                <StackPanel Name="ToolsPanel" Orientation="Horizontal" Margin="5,0" />
            </Grid>
            <StackPanel Name="ExportActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Name="ExtractTextButton" Style="{StaticResource TopRowToolStyle}" Background="{DynamicResource ViewerSurfaceBrush}" Width="94" Margin="0,0,8,0" Content="Extract text" Click="ExtractTextButton_Click" ToolTip="Extract text (E or Ctrl+Shift+T)" AutomationProperties.Name="Extract text" />
                <Button Name="CopyButton" AutomationProperties.LiveSetting="Polite" Style="{StaticResource ActionStyle}" Width="{StaticResource ToolbarButtonSize}" Height="{StaticResource ToolbarButtonSize}" Margin="0,0,8,0" Padding="0" Click="CopyButton_Click" ToolTip="Copy image with annotations (Ctrl+C)" AutomationProperties.Name="Copy image">
                    <Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9 9h12v12H9z M5 15H3V3h12v2" />
                </Button>
                <Button Name="SaveButton" AutomationProperties.LiveSetting="Polite" Style="{StaticResource PrimaryActionStyle}" Width="{StaticResource ToolbarButtonSize}" Height="{StaticResource ToolbarButtonSize}" Margin="0" Padding="0" Click="SaveAsButton_Click" ToolTip="Save a copy (Ctrl+Shift+S)" AutomationProperties.Name="Save copy">
                    <Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5 3h12l4 4v14H3V3z M7 3v6h10V3 M7 21v-8h10v8" />
                </Button>
            </StackPanel>
        </Grid>
        <Popup Name="ColorPickerPopup" Placement="Right" PlacementTarget="{Binding ElementName=ColorPickerButton}" StaysOpen="False" AllowsTransparency="True">
            <Border Name="ColorPickerSurface" Background="{DynamicResource ViewerSurfaceBrush}" BorderBrush="{DynamicResource ViewerSurfaceBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6" Width="218">
                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" /></Border.Effect>
                <StackPanel PreviewKeyDown="ColorPicker_KeyDown">
                    <TextBlock Text="Colors" FontSize="12" Foreground="{DynamicResource ViewerPrimaryTextBrush}" Margin="0,0,0,8" />
                    <UniformGrid Name="ExpandedColorSwatches" Columns="5" />
                    <TextBlock Text="Shades" FontSize="12" Foreground="{DynamicResource ViewerPrimaryTextBrush}" Margin="0,16,0,8" />
                    <UniformGrid Name="ColorShades" Columns="5" />
                    <TextBlock Text="Hex code" FontSize="12" Foreground="{DynamicResource ViewerPrimaryTextBrush}" Margin="0,16,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                        <TextBox Name="ColorHex" MaxLength="7" FontFamily="Consolas" Height="32" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource ViewerPageBackgroundBrush}" Foreground="{DynamicResource ViewerPrimaryTextBrush}" BorderBrush="{DynamicResource ViewerControlBorderBrush}" BorderThickness="1" AutomationProperties.Name="Hex color code" TextChanged="ColorHex_TextChanged" />
                        <Button Name="ApplyHexColorButton" Grid.Column="1" Style="{StaticResource ToolbarActionStyle}" Content="✓" Padding="0" Margin="4,0,0,0" Click="ApplyHexColor_Click" ToolTip="Apply hex color" AutomationProperties.Name="Apply hex color" />
                    </Grid>
                    <TextBlock Name="ColorHexError" Text="Use six hex digits, such as #A855F7." Visibility="Collapsed" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource ViewerSecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </Popup>
        <Grid Name="AnnotationOptionsTray" Panel.ZIndex="4" Visibility="Collapsed" Width="200" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,64,0,80">
            <Border Background="{DynamicResource ViewerSurfaceBrush}" CornerRadius="10">
                <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18" /></Border.Effect>
            </Border>
            <Grid Margin="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarActionStyle}" Content="×" Width="28" Padding="0" Click="HideProperties_Click" ToolTip="Hide properties" AutomationProperties.Name="Hide properties" />
                    <TextBlock Name="PropertiesHeading" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">8</sys:Double>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource OcrScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <StackPanel>
                <StackPanel Name="ColorOptionsGroup" Style="{StaticResource ToolbarGroupStyle}">
                    <TextBlock Text="Stroke color" Foreground="{DynamicResource ViewerSecondaryTextBrush}" FontSize="12" Margin="0,0,0,8" />
                    <StackPanel Name="ColorSwatches" Orientation="Horizontal">
                        <Border Width="1" Margin="4,0" Background="{DynamicResource ViewerSurfaceBorderBrush}" />
                        <Button Name="ColorPickerButton" Style="{StaticResource ActionStyle}" Width="24" Height="24" Margin="1,0" Padding="0" Click="ColorPickerButton_Click" ToolTip="More colors" AutomationProperties.Name="More colors">
                            <Border Name="CurrentColorSwatch" Width="24" Height="24" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource ViewerControlBorderBrush}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel Name="StrokeOptionsGroup" Style="{StaticResource ToolbarGroupStyle}">
                    <TextBlock Text="Stroke width" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,6" Foreground="{DynamicResource ViewerSecondaryTextBrush}" />
                    <ComboBox Name="StrokeWidthPicker" HorizontalAlignment="Stretch" SelectedIndex="1" SelectionChanged="StrokeWidth_Changed" ToolTip="Stroke width" AutomationProperties.Name="Stroke width">
                        <ComboBoxItem Content="Thin" Tag="2" /><ComboBoxItem Content="Medium" Tag="4" /><ComboBoxItem Content="Thick" Tag="7" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Name="TextOptionsGroup" Style="{StaticResource ToolbarGroupStyle}">
                    <TextBlock Text="Text size" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,6" Foreground="{DynamicResource ViewerSecondaryTextBrush}" />
                    <ComboBox Name="FontSizePicker" HorizontalAlignment="Stretch" SelectedIndex="2" SelectionChanged="FontSize_Changed" ToolTip="Text size in image pixels" AutomationProperties.Name="Text size">
                        <ComboBoxItem Content="16" /><ComboBoxItem Content="24" /><ComboBoxItem Content="28" /><ComboBoxItem Content="40" /><ComboBoxItem Content="64" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Name="NumberOptionsGroup" Style="{StaticResource ToolbarGroupStyle}" Visibility="Collapsed">
                    <TextBlock Text="Number" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,6" Foreground="{DynamicResource ViewerSecondaryTextBrush}" />
                    <TextBox Name="NumberPicker" Height="32" HorizontalAlignment="Stretch" MaxLength="4" VerticalContentAlignment="Center" TextAlignment="Center"
                             GotKeyboardFocus="NumberPicker_GotFocus" LostKeyboardFocus="NumberPicker_LostFocus"
                             PreviewKeyDown="NumberPicker_KeyDown" AutomationProperties.Name="Arrow number" />
                </StackPanel>
                <StackPanel Name="SketchOptionsGroup" Style="{StaticResource ToolbarGroupStyle}">
                    <TextBlock Text="Line style" FontSize="12" Foreground="{DynamicResource ViewerSecondaryTextBrush}" Margin="0,0,0,6" />
                    <UniformGrid Columns="2">
                        <ToggleButton Name="PreciseToggle" Style="{StaticResource ToolStyle}" Width="Auto" Content="Precise" Click="PreciseToggle_Click" AutomationProperties.Name="Precise line style" />
                        <ToggleButton Name="SketchToggle" Style="{StaticResource ToolStyle}" Width="Auto" Content="Sketch" Click="SketchToggle_Click" AutomationProperties.Name="Sketch style" />
                    </UniformGrid>
                </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Name="DeleteOptionsGroup" Grid.Row="2" Margin="0,8,0,0">
                    <Border Height="1" Background="{DynamicResource ViewerSurfaceBorderBrush}" Margin="0,0,0,8" />
                    <Button Name="RemoveButton" Style="{StaticResource ToolbarActionStyle}" HorizontalAlignment="Stretch" Click="RemoveButton_Click" ToolTip="Delete selected annotation (Delete)" AutomationProperties.Name="Delete selected annotation">
                        <StackPanel Orientation="Horizontal"><Path Data="M10 11v6 M14 11v6 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M3 6h18 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource ViewerPrimaryTextBrush}" StrokeThickness="1.7" Margin="0,0,8,0" /><TextBlock Text="Delete selection" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid VerticalAlignment="Bottom" Panel.ZIndex="3" Margin="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource ViewerSurfaceBrush}" CornerRadius="10" Padding="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ActionStyle}" Width="{StaticResource ToolbarButtonSize}" Height="{StaticResource ToolbarButtonSize}" Padding="0" Click="ZoomOutButton_Click" ToolTip="Zoom out (Ctrl+−)" AutomationProperties.Name="Zoom out">
                    <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M5 12h14" Stroke="{DynamicResource ViewerPrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                </Button>
                <Button Name="FitButton" Style="{StaticResource ActionStyle}" Content="Fit" MinWidth="54" Height="{StaticResource ToolbarButtonSize}" Click="FitButton_Click" ToolTip="Fit image (Ctrl+0)" />
                <Button Name="ZoomInButton" Style="{StaticResource ActionStyle}" Width="{StaticResource ToolbarButtonSize}" Height="{StaticResource ToolbarButtonSize}" Padding="0" Click="ZoomInButton_Click" ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in">
                    <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M5 12h14 M12 5v14" Stroke="{DynamicResource ViewerPrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                </Button>
                <Border Width="1" Height="19" Margin="7,0" Background="{DynamicResource ViewerSurfaceBorderBrush}" VerticalAlignment="Center" />
                <Button Name="UndoButton" Style="{StaticResource ActionStyle}" Padding="0" Width="{StaticResource ToolbarButtonSize}" Height="{StaticResource ToolbarButtonSize}" Click="UndoButton_Click" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
                    <Path Data="M8 5L3 10 8 15 M3 10H13C21 10 21 21 13 21" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ViewerPrimaryTextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
                <Button Name="RedoButton" Style="{StaticResource ActionStyle}" Padding="0" Width="{StaticResource ToolbarButtonSize}" Height="{StaticResource ToolbarButtonSize}" Click="RedoButton_Click" ToolTip="Redo (Ctrl+Shift+Z)" AutomationProperties.Name="Redo">
                    <Path Data="M16 5L21 10 16 15 M21 10H11C3 10 3 21 11 21" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ViewerPrimaryTextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
            </StackPanel>
            </Border>
            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" Padding="8,5" CornerRadius="8" Background="{DynamicResource ViewerSurfaceBrush}">
                <Border.Style><Style TargetType="Border"><Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=EditorStatus}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers></Style></Border.Style>
                <TextBlock Name="EditorStatus" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ViewerSecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
            </Border>
        </Grid>
    </Grid>
        <Border Name="ImageLoadingOverlay" Visibility="Collapsed" Background="{DynamicResource ViewerCanvasBrush}">
            <StackPanel MaxWidth="440" Margin="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Name="ImageLoadingHeading" Text="Loading image…" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource ViewerPrimaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Name="ImageLoadingName" Margin="0,12,0,20" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           Foreground="{DynamicResource ViewerSecondaryTextBrush}" />
                <ProgressBar Name="ImageLoadingProgress" Width="180" Height="4" BorderThickness="0"
                             Foreground="{DynamicResource ViewerAccentBrush}" Background="{DynamicResource ViewerSurfaceBorderBrush}"
                             AutomationProperties.Name="Loading image" />
                <TextBlock Name="ImageLoadingDetail" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource ViewerSecondaryTextBrush}" />
                <Button Name="ImageLoadingClose" Content="Cancel" Style="{StaticResource ActionStyle}" Padding="18,8"
                        HorizontalAlignment="Center" Margin="0,24,0,0" Click="CancelImageLoading_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
